{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "simulator": {
      "distribution": "internal",
      "node": "24.11.1",
      "pnpm": "10.33.0",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_SUPABASE_URL": "http://127.0.0.1:54321",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "placeholder-anon-key-for-simulator-smoke-build",
        "EXPO_PUBLIC_WEB_URL": "http://localhost:8081"
      }
    },
    "device": {
      "distribution": "internal",
      "node": "24.11.1",
      "pnpm": "10.33.0",
      "environment": "preview",
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  }
}
