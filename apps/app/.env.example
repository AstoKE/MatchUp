# Public client configuration (bundled into the app — NEVER put secrets here).
# For local development run `pnpm env:local` after `supabase start`; it writes .env.local.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase anon/publishable key only. A service_role / sb_secret_ key is rejected at startup.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_WEB_URL=http://localhost:8081
# Optional: Sentry DSN (public by design). Leave empty to disable error reporting.
EXPO_PUBLIC_SENTRY_DSN=
# Optional: Cloudflare Turnstile SITE key (public). Leave empty while the Supabase project has CAPTCHA off
# (the local stack does). Cloudflare's always-pass test key for the auth lab: 1x00000000000000000000AA
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# Optional: MapLibre style URL with the tile provider's key (public, restricted to the app's origins). Empty = no map.
# e.g. https://api.maptiler.com/maps/streets-v2/style.json?key=<your key>
EXPO_PUBLIC_MAP_STYLE_URL=
