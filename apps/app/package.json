{
  "name": "@matchup/app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node ../../scripts/copy-map-worker.mjs && expo start",
    "web": "node ../../scripts/copy-map-worker.mjs && expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export:web": "node ../../scripts/copy-map-worker.mjs && expo export --platform web",
    "export:native": "expo export --platform android --platform ios --output-dir dist-native",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "test": "jest",
    "doctor": "expo-doctor",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "jest": {
    "preset": "jest-expo",
    "maxWorkers": 4,
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.after-env.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@expo-google-fonts/figtree": "0.4.1",
    "@expo/metro-runtime": "~58.0.17",
    "@hookform/resolvers": "^7.0.3",
    "@maplibre/maplibre-react-native": "11.5.1",
    "@matchup/config": "workspace:*",
    "@matchup/domain": "workspace:*",
    "@sentry/react-native": "~8.34.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.106.1",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.17",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "i18next": "^26.7.2",
    "maplibre-gl": "6.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.13",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "~10.14.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "serve": "^14.2.6",
    "test-renderer": "^1.3.1",
    "typescript": "~7.0.2"
  }
}
