{
  "name": "matchup",
  "private": true,
  "version": "0.0.0",
  "description": "MatchUp (working name) — sports community app. See docs/.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.3.0 <25",
    "pnpm": ">=10.33.0 <11"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:brand": "node scripts/check-brand-literals.mjs",
    "test": "pnpm -r --filter=!@matchup/db-tests test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:brand && pnpm test:scripts && pnpm test",
    "prepare": "husky",
    "db:start": "supabase start -x studio,imgproxy,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "node scripts/gen-types.mjs",
    "env:local": "node scripts/write-local-env.mjs",
    "test:integration": "pnpm --filter @matchup/db-tests test",
    "test:e2e": "pnpm --filter @matchup/app test:e2e",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "~9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
